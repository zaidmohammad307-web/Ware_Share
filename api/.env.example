# Copy to api/.env and fill in. Never commit the real .env file.

# --- Required ---
DB_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/wareshare
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Strongly recommended ---
# The single admin account. If unset, admin pages are disabled.
ADMIN_EMAIL=
# Frontend origin(s) allowed to call the API (comma-separated)
CORS_ORIGINS=https://your-frontend.example.com
NODE_ENV=production

# --- Optional ---
PORT=8000
JWT_EXPIRY=7d
GOOGLE_CLIENT_ID=
# Booking / support email notifications (disabled if unset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Identify yourself to OpenStreetMap Nominatim (required by their usage policy)
NOMINATIM_EMAIL=
NOMINATIM_USER_AGENT=
CORS_DEBUG=false
